# LLM 端点（OpenAI 兼容）。无 key 时 canned/FunctionModel 离线模式仍可跑。
MLIP_AGENT_LLM_MODEL=
MLIP_AGENT_LLM_BASE_URL=
MLIP_AGENT_LLM_API_KEY=

# 计算环境（Python 3.12，装有 torch/ase/maple/nequip/fairchem）。
# 后端绝不 import 其中的包，只通过 $COMPUTE_VENV/bin/maple 和
# $COMPUTE_VENV/bin/python 两个入口以子进程方式调用。
COMPUTE_VENV=/root/soft/ml_potential/.venv

# 全部 checkpoint 集中存放于 /root/soft/ml_potential/checkpoints/（TICKET-0010）

# UMA 本地 checkpoint（禁止联网下载，必须绝对路径）
UMA_CHECKPOINT_PATH=/root/soft/ml_potential/checkpoints/uma/uma-s-1p1.pt

# NequIP-OAM-XL 本地模型 zip（nequip-package 格式，绝对路径）
NEQUIP_MODEL_PATH=/root/soft/ml_potential/checkpoints/nequip/NequIP-OAM-XL-0.1.nequip.zip

# MACE-MPA-0 (medium) 本地 scripted wrapper（绝对路径；
# 由 scripts/make_macempa0_wrapper.py 生成，MAPLE 插件后端 macempa0 用）
MACEMPA0_MODEL_PATH=/root/soft/ml_potential/checkpoints/mace/macempa0.pt

# DPA4C（OMol25 单域族）本地 checkpoint（绝对路径；job.json family="dpa4c" 时默认用此模型）
DPA4C_MODEL_PATH=/root/soft/ml_potential/checkpoints/dpa4/DPA4C-Air-OMol25-100M-v20260820.pt

# 会话/作业数据目录（M2 起；默认 ./data，不入库）
MLIP_AGENT_DATA_DIR=data

# 计算子进程默认超时（秒）
MLIP_AGENT_DEFAULT_TIMEOUT_S=1800
